DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=kore.example.com
CSRF_TRUSTED_ORIGINS=https://kore.example.com
HEALTHCHECK_HOST=kore.example.com
DATABASE_URL=postgres://kore:replace-postgres-password@postgres:5432/kore_agro
REDIS_URL=redis://redis:6379/0
KORE_DEFAULT_MILK_PRICE=0.45
SRI_ADAPTER_CLASS=
EXTERNAL_INFO_ERROR_CACHE_SECONDS=300
LOGIN_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=25
LOGIN_LOCKOUT_SECONDS=900
KORE_MAX_FIELD_DEVICES_PER_USER=5
EXTERNAL_INFO_ALLOWED_HOSTS=api.open-meteo.com,geocoding-api.open-meteo.com,datosabiertos.gob.ec
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=kore_agro
POSTGRES_USER=kore
POSTGRES_PASSWORD=replace-postgres-password
WEB_PORT=8000
WEB_BIND_ADDRESS=127.0.0.1
BACKUP_RETENTION_DAYS=14
