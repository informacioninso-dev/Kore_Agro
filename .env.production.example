DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=kore.example.com
CSRF_TRUSTED_ORIGINS=https://kore.example.com
DATABASE_URL=postgres://kore:replace-postgres-password@postgres:5432/kore_agro
REDIS_URL=redis://redis:6379/0
KORE_DEFAULT_MILK_PRICE=0.45
SRI_ADAPTER_CLASS=

POSTGRES_DB=kore_agro
POSTGRES_USER=kore
POSTGRES_PASSWORD=replace-postgres-password
WEB_PORT=8000
